ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://ekc:ekc_dev_password@localhost:5432/enterprise_knowledge_copilot

JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

SESSION_COOKIE_NAME=ekc_session
COOKIE_SECURE=false
# In production (frontend and backend on different domains), set:
#   COOKIE_SECURE=true
#   COOKIE_SAMESITE=none
COOKIE_SAMESITE=lax

CREDENTIAL_ENCRYPTION_KEY=

FRONTEND_ORIGIN=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/sources/google-drive/callback

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:8000/api/sources/slack/callback

# Which model answers first ("groq" or "gemini"); the other is the fallback.
# Groq is the default because it is much faster from the EC2 server.
LLM_PRIMARY=groq

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_UTILITY_MODEL=gemini-flash-lite-latest

GROQ_API_KEY=
# Groq retires models over time — if chat calls 404, run this to see what's
# currently live: curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
# GROQ_UTILITY_MODEL needs a plain (non-reasoning) model: reasoning models
# spend their token budget "thinking" before answering, and utility calls
# here use very small max_tokens (e.g. 8, for the RETRIEVE/DIRECT routing
# decision) — too small for a reasoning model to ever emit real content.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_UTILITY_MODEL=allam-2-7b

# Agent ops: traces go to the self-hosted Phoenix container (docker-compose).
# Safe to leave enabled even with Phoenix stopped — export failures are non-fatal.
OTEL_ENABLED=true
PHOENIX_ENDPOINT=http://localhost:6006
