# Backend config for running under docker compose.
#
# Copy to .env.docker (gitignored) and fill in the blanks:
#   cp backend/.env.docker.example backend/.env.docker
#
# DATABASE_URL and PHOENIX_ENDPOINT are intentionally absent — docker-compose.yml
# sets both, pointing at service names instead of localhost. Anything set here
# would be overridden anyway.

ENVIRONMENT=development

# Generate: openssl rand -base64 32
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

SESSION_COOKIE_NAME=ekc_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Encrypts stored OAuth tokens. Must be a Fernet key, not a random string:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it later makes every already-stored token undecryptable.
CREDENTIAL_ENCRYPTION_KEY=

FRONTEND_ORIGIN=http://localhost:3000

# Source connectors. The app runs without these — connecting a source is what fails.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:7860/api/sources/google-drive/callback

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:7860/api/sources/slack/callback

# Chat LLM — remote APIs, Gemini first with Groq as fallback.
# At least one is needed for chat to answer.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_UTILITY_MODEL=gemini-flash-lite-latest

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Must be a plain (non-reasoning) model: utility calls use very small
# max_tokens, too small for a reasoning model to emit real content.
GROQ_UTILITY_MODEL=allam-2-7b

# Traces to the Phoenix container. Export failures are non-fatal.
OTEL_ENABLED=true
